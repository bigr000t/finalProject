<section class="panel" id="community"
  data-user-id="<%= user ? user.id : '' %>"
  data-user-role="<%= user ? user.role : 'guest' %>">

  <!-- ==================== 게시판 헤더 ==================== -->

  <div class="community-header">
    <div>
      <h2>커뮤니티</h2>
      <p class="hint">도전 기록과 공략을 공유하세요.</p>
    </div>

    <% if (user) { %>
      <button type="button" class="primary" id="writePost">글쓰기</button>
    <% } %>
  </div>

  <!-- ==================== 게시판 탭 ==================== -->

  <nav class="community-tabs" id="boardTabs" aria-label="게시판">
    <button type="button" class="active" data-board-id="0">전체</button>
  </nav>

  <% if (user && user.role === "admin") { %>
    <button type="button" id="openReports">
      신고 관리 (<span id="pendingReportCount">0</span>)
    </button>
  <% } %>

  <!-- ==================== 게시글 목록 ==================== -->

  <div id="postListView">

    <div class="community-toolbar">
      <span id="postCount">게시글 0개</span>

      <select id="postSort" aria-label="게시글 정렬">
        <option value="latest">최신순</option>
        <option value="likes">추천순</option>
      </select>
    </div>

    <div class="post-list">
      <div class="post-list-head">
        <span>분류</span>
        <span>제목</span>
        <span>작성자</span>
        <span>추천</span>
        <span>작성일</span>
      </div>

      <div id="postList">
        <p class="empty-posts">게시글을 불러오는 중입니다.</p>
      </div>
    </div>

    <div class="community-pagination" id="postPagination"></div>

    <!-- 게시글 검색 -->

    <form class="community-search" id="postSearchForm">
      <select id="searchType" aria-label="검색 조건">
        <option value="all">제목 + 내용</option>
        <option value="title">제목</option>
        <option value="content">내용</option>
        <option value="author">작성자</option>
      </select>

      <input type="search" id="searchKeyword"
        placeholder="검색어 입력" maxlength="200" aria-label="검색어">

      <button type="submit">검색</button>
      <button type="button" id="resetSearch">초기화</button>
    </form>

    <% if (!user) { %>
      <p class="hint">게시글을 작성하려면 로그인해야 합니다.</p>
    <% } %>

  </div>

  <!-- ==================== 게시글 상세보기 ==================== -->

  <div id="postDetailView" hidden>

    <button type="button" class="community-back">목록으로</button>

    <article id="postDetailContent"></article>

    <!-- 게시글 추천 및 신고 -->

    <div class="post-actions" id="postActions"></div>

    <!-- 댓글 -->

    <section class="comment-section">
      <h3>댓글 <span id="commentCount">0</span>개</h3>

      <div id="commentList">
        <p class="hint">등록된 댓글이 없습니다.</p>
      </div>

      <% if (user) { %>
        <form id="commentForm" class="comment-form">
          <textarea id="commentContent" name="content"
            placeholder="댓글을 입력하세요." aria-label="댓글"
            maxlength="2000" required></textarea>

          <button type="submit" class="primary">댓글 등록</button>
        </form>
      <% } else { %>
        <p class="hint">댓글을 작성하려면 로그인해야 합니다.</p>
      <% } %>
    </section>

  </div>

  <!-- ==================== 게시글 작성 및 수정 ==================== -->

  <% if (user) { %>

    <div id="postEditorView" hidden>

      <button type="button" class="community-back">목록으로</button>
      <h3 id="postEditorTitle">게시글 작성</h3>

      <form id="postForm" class="post-form">

        <label for="postBoard">게시판</label>
        <select id="postBoard" name="board_id" required></select>

        <label for="postTitle">제목</label>
        <input type="text" id="postTitle" name="title"
          maxlength="200" placeholder="제목을 입력하세요." required>

        <label for="postContent">내용</label>
        <textarea id="postContent" name="content"
          rows="15" placeholder="내용을 입력하세요." required></textarea>

        <div class="post-form-actions">
          <button type="button" class="community-back">취소</button>
          <button type="submit" class="primary" id="submitPost">등록</button>
        </div>

      </form>

    </div>

  <% } %>

  <!-- ==================== 관리자 신고 관리 ==================== -->

  <% if (user && user.role === "admin") { %>

    <div id="reportListView" hidden>

      <button type="button" class="community-back">목록으로</button>

      <div class="community-toolbar">
        <h3>신고 관리</h3>

        <select id="reportStatus" aria-label="신고 처리 상태">
          <option value="pending">미처리</option>
          <option value="dismissed">기각</option>
          <option value="resolved">처리 완료</option>
          <option value="all">전체</option>
        </select>
      </div>

      <div id="reportList">
        <p class="hint">접수된 신고가 없습니다.</p>
      </div>

      <div class="community-pagination" id="reportPagination"></div>

    </div>

  <% } %>

</section>
